<?xml version="1.0" encoding="utf-8"?>
<!-- Per-user installer: no administrator rights, installs to %LOCALAPPDATA%\Programs\Scratchpad.
     Built by build-installer.ps1, which passes Version, ExePath and IconPath. See ADR 0091. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Scratchpad" Manufacturer="Scratchpad" Version="$(Version)"
           UpgradeCode="FE059411-3D28-4BBF-B7D6-3405845AD5E2" Scope="perUser" Language="1033">
    <!-- The stable UpgradeCode above lets a newer MSI replace an older install in place; same-version
         upgrades let a rebuilt MSI (new ProductCode) replace one built earlier from the same version. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Scratchpad is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="Scratchpad.ico" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="Scratchpad.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Scratchpad" />
      </Directory>
    </StandardDirectory>

    <!-- Windows requires a per-user component to be keyed on an HKCU registry value, not a file,
         and such a component needs an explicit GUID. Never change it: it identifies this
         component across upgrades. -->
    <Component Id="Application" Directory="INSTALLFOLDER" Guid="F080979E-F638-4937-BA90-5FBA0A59A544">
      <File Id="ScratchpadExe" Source="$(ExePath)" Name="scratchpad.exe">
        <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Scratchpad"
                  WorkingDirectory="INSTALLFOLDER" Advertise="no" />
      </File>
      <RegistryValue Root="HKCU" Key="Software\Scratchpad" Name="Installed" Type="integer"
                     Value="1" KeyPath="yes" />
      <!-- App Paths lets the shell (Win+R, `start scratchpad`, Explorer's address bar) find the
           exe without it being on PATH. Typing it at a cmd or PowerShell prompt still needs PATH. -->
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\scratchpad.exe"
                     Type="string" Value="[INSTALLFOLDER]scratchpad.exe" />
      <!-- Folders in the user profile are not cleaned up automatically (ICE64). Only empty folders
           are removed, so a Programs folder shared with other apps survives. -->
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsDir" On="uninstall" />
    </Component>

    <!-- "Open with" for .md, .markdown and .txt, per user, without taking over the default
         handler (ADR 0095). Applications\scratchpad.exe names the app and its open verb; a ProgID
         per kind of file is listed under each extension's OpenWithProgids, which is all Windows
         needs to offer it. No extension's default value is ever written. Like the component above,
         it is keyed on an HKCU value and its GUID must never change. -->
    <Component Id="OpenWith" Directory="INSTALLFOLDER" Guid="6C1E2B0A-58D4-4F3B-9E57-2A9C3D1F7B64">
      <RegistryValue Root="HKCU" Key="Software\Scratchpad" Name="OpenWith" Type="integer"
                     Value="1" KeyPath="yes" />

      <RegistryKey Root="HKCU" Key="Software\Classes\Applications\scratchpad.exe"
                   ForceDeleteOnUninstall="yes">
        <RegistryValue Name="FriendlyAppName" Type="string" Value="Scratchpad" />
        <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]scratchpad.exe&quot;,0" />
        <RegistryValue Key="shell\open\command" Type="string"
                       Value="&quot;[INSTALLFOLDER]scratchpad.exe&quot; &quot;%1&quot;" />
        <RegistryValue Key="SupportedTypes" Name=".md" Type="string" Value="" />
        <RegistryValue Key="SupportedTypes" Name=".markdown" Type="string" Value="" />
        <RegistryValue Key="SupportedTypes" Name=".txt" Type="string" Value="" />
      </RegistryKey>

      <RegistryKey Root="HKCU" Key="Software\Classes\Scratchpad.Markdown" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="Markdown Document" />
        <RegistryValue Name="FriendlyTypeName" Type="string" Value="Markdown Document" />
        <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]scratchpad.exe&quot;,0" />
        <RegistryValue Key="shell\open" Name="FriendlyAppName" Type="string" Value="Scratchpad" />
        <RegistryValue Key="shell\open\command" Type="string"
                       Value="&quot;[INSTALLFOLDER]scratchpad.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\Scratchpad.Text" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="Text Document" />
        <RegistryValue Name="FriendlyTypeName" Type="string" Value="Text Document" />
        <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]scratchpad.exe&quot;,0" />
        <RegistryValue Key="shell\open" Name="FriendlyAppName" Type="string" Value="Scratchpad" />
        <RegistryValue Key="shell\open\command" Type="string"
                       Value="&quot;[INSTALLFOLDER]scratchpad.exe&quot; &quot;%1&quot;" />
      </RegistryKey>

      <!-- Only these named values are removed on uninstall; the extension keys are shared. -->
      <RegistryValue Root="HKCU" Key="Software\Classes\.md\OpenWithProgids" Name="Scratchpad.Markdown"
                     Type="string" Value="" />
      <RegistryValue Root="HKCU" Key="Software\Classes\.markdown\OpenWithProgids" Name="Scratchpad.Markdown"
                     Type="string" Value="" />
      <RegistryValue Root="HKCU" Key="Software\Classes\.txt\OpenWithProgids" Name="Scratchpad.Text"
                     Type="string" Value="" />
    </Component>

    <Feature Id="Main" Title="Scratchpad">
      <ComponentRef Id="Application" />
      <ComponentRef Id="OpenWith" />
    </Feature>
  </Package>
</Wix>
